    TweenService:Create(card1Scale, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = 1,
    }):Play()
    TweenService:Create(card1, TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.fromScale(0.5, 0.5),
    }):Play()
end)

local switching = false
local function goToDiscord()
    if switching then return end
    switching = true

    TweenService:Create(card1Scale, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Scale = 0.88,
    }):Play()
    TweenService:Create(card1, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, 0, 0.5, -30),
    }):Play()

    task.delay(0.3, function()
        card1.Visible = false
        card2.Visible = true

        local card2Scale = Instance.new("UIScale")
        card2Scale.Parent = card2
        card2Scale.Scale = 0.85
        card2.Position = UDim2.new(0.5, 0, 0.5, 40)

        burstRing()

        TweenService:Create(card2Scale, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = 1,
        }):Play()
        TweenService:Create(card2, TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.fromScale(0.5, 0.5),
        }):Play()
        switching = false
    end)
end

local function openDiscord()
    if CONFIG.DiscordLink == "" then return end

    local ok = pcall(function()
        game:GetService("GuiService"):OpenBrowserWindow(CONFIG.DiscordLink)
    end)

    if not ok then
        if clipboardFunction then
            pcall(clipboardFunction, CONFIG.DiscordLink)
            warn("[公告UI] 无法自动打开浏览器，链接已复制到剪贴板：" .. CONFIG.DiscordLink)
        else
            warn("[公告UI] 无法打开浏览器，请手动访问：" .. CONFIG.DiscordLink)
        end
    end
end

local function executeScript(alsoOpenDiscord)
    local card2Scale = card2:FindFirstChildOfClass("UIScale")
    if card2Scale then
        TweenService:Create(card2Scale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Scale = 0.85,
        }):Play()
    end
    TweenService:Create(card2, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, 0, 0.5, 40),
    }):Play()
    TweenService:Create(overlay, TweenInfo.new(0.3), {
        BackgroundTransparency = 1,
    }):Play()

    task.delay(0.32, function()
        gui:Destroy()

        if alsoOpenDiscord then
            openDiscord()
        end

        local ok, err = pcall(function()
            (loadstring or load)(game:HttpGet(CONFIG.ScriptURL))()
        end)
        if not ok then
            warn("[公告UI] 脚本加载失败: " .. tostring(err))
        end
    end)
end

confirmBtn.MouseButton1Click:Connect(goToDiscord)
mustBtn.MouseButton1Click:Connect(function()
    executeScript(true)
end)
refuseBtn.MouseButton1Click:Connect(function()
    executeScript(false)
end)