local logoAsset = nil
local logoState = "loading"
local logoWaiting = {}

local function onLogoReady(cb)
    if logoState == "ready" then
        pcall(cb, logoAsset)
    elseif logoState == "loading" then
        table.insert(logoWaiting, cb)
    end
end

local function downloadLogo()
    if not assetFunction then
        logoState = "failed"
        return
    end

    local body

    if type(requestFunction) == "function" and canFile then
        local ok, res = pcall(requestFunction, {
            Url = CONFIG.LogoURL,
            Method = "GET",
        })
        if ok and type(res) == "table"
            and type(res.Body) == "string" and res.Body ~= ""
            and (res.StatusCode == nil or res.StatusCode == 200) then
            body = res.Body
            pcall(writefile, CONFIG.LogoFile, body)
        end
    end

    if not body and canFile then
        local okc, cached = pcall(function()
            if isfile(CONFIG.LogoFile) then
                return readfile(CONFIG.LogoFile)
            end
        end)
        if okc and type(cached) == "string" and cached ~= "" then
            body = cached
        end
    end

    if not body then
        logoState = "failed"
        return
    end

    local ok2, asset = pcall(assetFunction, CONFIG.LogoFile)
    if not ok2 or not asset or asset == "" then
        logoState = "failed"
        return
    end

    logoAsset = asset
    logoState = "ready"

    for _, cb in ipairs(logoWaiting) do
        pcall(cb, logoAsset)
    end
    logoWaiting = {}
end

task.spawn(downloadLogo)

local function buildLogo(parent, sizePx, layoutOrder, radius)
    local r = radius or 14

    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(0, sizePx, 0, sizePx)
    wrap.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    wrap.BorderSizePixel = 0
    wrap.LayoutOrder = layoutOrder
    wrap.ZIndex = 3
    wrap.Parent = parent
    corner(wrap, r)

    local ws = Instance.new("UIStroke")
    ws.Thickness = 1.5
    ws.Transparency = 0
    ws.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    ws.Parent = wrap
    triGradient(ws, 45)

    local halo = Instance.new("UIStroke")
    halo.Color = CONFIG.Accent
    halo.Thickness = 5
    halo.Transparency = 0.82
    halo.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    halo.Parent = wrap

    local fallback = Instance.new("Frame")
    fallback.Size = UDim2.fromScale(1, 1)
    fallback.BackgroundColor3 = CONFIG.Accent
    fallback.BorderSizePixel = 0
    fallback.ZIndex = 3
    fallback.Parent = wrap
    corner(fallback, r)
    triGradient(fallback, 45)

    local fallbackLbl = Instance.new("TextLabel")
    fallbackLbl.Size = UDim2.fromScale(1, 1)
    fallbackLbl.BackgroundTransparency = 1
    fallbackLbl.Text = "纸"
    fallbackLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    fallbackLbl.TextSize = math.floor(sizePx * 0.42)
    fallbackLbl.Font = Enum.Font.GothamBlack
    fallbackLbl.ZIndex = 4
    fallbackLbl.Parent = fallback

    local img = Instance.new("ImageLabel")
    img.Size = UDim2.fromScale(1, 1)
    img.BackgroundTransparency = 1
    img.Image = ""
    img.ScaleType = Enum.ScaleType.Crop
    img.ZIndex = 4
    img.Parent = wrap
    corner(img, r)

    onLogoReady(function(asset)
        img.Image = asset
        fallback.Visible = false
    end)

    return wrap, img, fallback
end

